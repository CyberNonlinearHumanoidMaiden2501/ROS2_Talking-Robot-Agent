# Play PCM segments on the speaker. Cancel mid-play to interrupt (barge-in);
# the result reports exactly how far playback got so the brain can record
# the response as-spoken.
vr_interfaces/SpeechSegment[] segments   # ordered list of audio segments
int32 sample_rate
---
bool completed
int32 last_segment_index
int32 samples_played_in_last
---
int32 segment_index       # segment currently playing (0-based)
int32 samples_played      # samples played of the current segment so far
